# Copy this file to .env for local development.
# In Azure App Service, configure these values as App Settings instead of committing them.

SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Azure production example:
# DEBUG=False
# SECRET_KEY=<strong-production-secret>
# ALLOWED_HOSTS=<app-name>.azurewebsites.net,<custom-domain>
# CSRF_TRUSTED_ORIGINS=https://<app-name>.azurewebsites.net,https://<custom-domain>
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TIME_ZONE=UTC

DB_ENGINE=django.db.backends.postgresql
DB_NAME=maistorly_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=0

# Azure PostgreSQL example:
# DB_NAME=<postgres-database>
# DB_USER=<postgres-user>
# DB_PASSWORD=<postgres-password>
# DB_HOST=<postgres-host>
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@maistorly.local
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

STATIC_URL=/static/
STATIC_ROOT=staticfiles
STATICFILES_STORAGE_BACKEND=
MEDIA_URL=/media/
MEDIA_ROOT=media

# Required when DEBUG=False. Uploaded media stays on Cloudinary in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
